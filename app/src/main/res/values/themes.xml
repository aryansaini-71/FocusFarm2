<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FocusFarm" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/moss</item>
        <item name="colorPrimaryVariant">@color/leaf</item>
        <item name="colorSecondary">@color/sprout</item>
        <item name="colorOnPrimary">@color/sky</item>
        <item name="android:windowBackground">@color/sky</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Theme.FocusFarm.Dialog" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="colorPrimary">@color/moss</item>
        <item name="colorAccent">@color/leaf</item>
    </style>

    <style name="BottomNavTextActive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BottomNavTextInactive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Theme.FocusFarm.Overlay" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/moss</item>
        <item name="colorSecondary">@color/moss</item>
        <item name="colorAccent">@color/moss</item>
        <item name="colorControlActivated">@color/moss</item>
        <item name="colorControlHighlight">@color/sprout</item>
        <item name="android:colorAccent">@color/moss</item>
    </style>

    <style name="Widget.FocusFarm.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/moss</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.FocusFarm.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/moss</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textColor">@color/moss</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">17sp</item>
        <item name="cornerRadius">14dp</item>
    </style>
</resources>
