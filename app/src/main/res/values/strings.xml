<resources>
    <string name="app_name">Anti-Brain Rot</string>

    <string name="accessibility_service_description">
        Blocks distracting apps (Instagram, TikTok) with a 60-second cognitive friction screen to reduce brain rot.
    </string>

    <string name="welcome_message">
        Welcome to Anti-Brain Rot.\n\n
        1. Tap the button below.\n
        2. Enable \"Anti-Brain Rot\" in Accessibility settings.\n
        3. Open Instagram or TikTok to test the overlay.
    </string>
    <string name="btn_open_accessibility">Open Accessibility Settings</string>

