    <string name="quiz_1_paragraph">Our solar system has eight planets orbiting the Sun. Mercury is the smallest planet and has almost no atmosphere. Venus is wrapped in thick clouds, and Earth is the only world we know that supports life.</string>
    <string name="quiz_1_question">What is the closest planet to the Sun?</string>
    <string name="quiz_1_answer_a">Mercury</string>
    <string name="quiz_1_answer_b">Venus</string>
    <string name="quiz_1_answer_c">Earth</string>

    <string name="quiz_2_paragraph">Healthy sleep helps your brain store memories and regulate mood. Most teens need about 8–10 hours per night. Screens before bed can delay melatonin, the hormone that makes you feel sleepy.</string>
    <string name="quiz_2_question">What hormone helps you feel sleepy?</string>
    <string name="quiz_2_answer_a">Insulin</string>
    <string name="quiz_2_answer_b">Melatonin</string>
    <string name="quiz_2_answer_c">Adrenaline</string>

    <string name="quiz_3_paragraph">Plants use sunlight to make sugar in their leaves. Water travels up from roots through the stem. Farmers rotate crops so soil stays rich in nutrients season after season.</string>
    <string name="quiz_3_question">Where does most photosynthesis happen in a plant?</string>
    <string name="quiz_3_answer_a">Roots</string>
    <string name="quiz_3_answer_b">Stem</string>
    <string name="quiz_3_answer_c">Leaves</string>

    <string name="quiz_4_paragraph">Taking short breaks during study can improve focus more than scrolling social apps. Pausing for a few deep breaths lowers stress and helps you return to the task with a clearer mind.</string>
    <string name="quiz_4_question">What is a helpful alternative to doom-scrolling during a study break?</string>
    <string name="quiz_4_answer_a">A short breathing exercise</string>
    <string name="quiz_4_answer_b">Opening more social feeds</string>
    <string name="quiz_4_answer_c">Switching to another distracting app</string>
