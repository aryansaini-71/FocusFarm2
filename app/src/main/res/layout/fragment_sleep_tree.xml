<?xml version="1.0" encoding="utf-8"?>
<!-- Sleep Tree tab placeholder — tree grows as user sleeps well -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <ImageView
        android:id="@+id/img_sleep_tree"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:contentDescription="@string/sleep_tree_content_description"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_placeholder_tree"
        app:layout_constraintBottom_toTopOf="@id/tv_sleep_tree_status"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tv_sleep_tree_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/img_sleep_tree" />

</androidx.constraintlayout.widget.ConstraintLayout>
