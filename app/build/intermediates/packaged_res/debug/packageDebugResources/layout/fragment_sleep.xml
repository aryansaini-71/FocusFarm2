<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sky"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

  <!-- SleepFragment: streak dots, sleep duration, reward card -->

    <ImageView
        android:id="@+id/img_sleep_tree"
        android:layout_width="@dimen/tree_lvl2"
        android:layout_height="@dimen/tree_lvl2"
        android:contentDescription="@string/sleep_tree_content_description"
        android:src="@drawable/treelvl1" />

    <TextView
        android:id="@+id/tv_sleep_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/sleep_placeholder"
        android:textColor="@color/soil"
        android:textSize="20sp" />

</LinearLayout>
