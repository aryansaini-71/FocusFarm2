<?xml version="1.0" encoding="utf-8"?>
<!--
  Farm tab placeholder.
  TODO: replace img_farm_grid with your isometric tile grid View.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Placeholder for the isometric farm grid -->
    <ImageView
        android:id="@+id/img_farm_grid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="16dp"
        android:background="@color/minigame_placeholder_bg"
        android:contentDescription="@string/farm_grid_content_description"
        android:scaleType="centerInside"
        android:src="@drawable/ic_placeholder_farm"
        app:layout_constraintBottom_toTopOf="@id/tv_total_points"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Points earned from focus sessions -->
    <TextView
        android:id="@+id/tv_total_points"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/total_points_placeholder"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
