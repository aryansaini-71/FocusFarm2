<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sky"
    android:padding="@dimen/screen_padding">

    <ImageView
        android:id="@+id/img_farm_base"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/farm_grid_content_description"
        android:scaleType="fitCenter"
        android:src="@drawable/farmbase"
        app:layout_constraintBottom_toTopOf="@id/tv_farm_points"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_farm_points"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/farm_points_placeholder"
        android:textColor="@color/moss"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
