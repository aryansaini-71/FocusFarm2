<?xml version="1.0" encoding="utf-8"?>
<!-- Single row in the Recent Activity list -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_stats_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_activity_icon_circle">

        <ImageView
            android:id="@+id/img_activity_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_activity_leaf" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_activity_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/stats_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_activity_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/stats_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_activity_points"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/stats_accent_green"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
